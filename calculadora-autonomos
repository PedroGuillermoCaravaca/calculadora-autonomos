<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Calculadora Autónomos</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <style>
    :root {
      --bg-main: #000000;
      --bg-screen: #1c1c1e;
      --bg-key-dark: #333333;
      --bg-key-light: #a5a5a5;
      --bg-key-accent: #ff9f0a;
      --text-main: #ffffff;
      --text-muted: #d4d4d4;
    }

    * {
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui,
        sans-serif;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top, #2c2c2e 0, #000000 60%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      color: var(--text-main);
    }

    .calculator {
      width: 100%;
      max-width: 420px;
      background: rgba(0, 0, 0, 0.9);
      border-radius: 32px;
      padding: 16px 16px 24px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .screen {
      background: var(--bg-screen);
      border-radius: 24px;
      padding: 14px 16px;
      margin-bottom: 12px;
      min-height: 120px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .screen-title {
      font-size: 13px;
      color: var(--text-muted);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }

    .screen-main {
      text-align: right;
      font-size: 32px;
      font-weight: 600;
      margin-bottom: 4px;
      word-break: break-word;
    }

    .screen-sub {
      text-align: right;
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.4;
      white-space: pre-line;
    }

    .section-title {
      font-size: 14px;
      color: var(--text-muted);
      margin: 8px 2px 4px;
    }

    .inputs {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin-bottom: 8px;
    }

    .input-block {
      grid-column: span 2;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .input-block.full {
      grid-column: span 4;
    }

    label {
      font-size: 11px;
      color: var(--text-muted);
    }

    input[type="number"] {
      width: 100%;
      padding: 6px 8px;
      border-radius: 14px;
      border: none;
      background: #2c2c2e;
      color: var(--text-main);
      font-size: 14px;
      text-align: right;
      outline: none;
    }

    input[type="number"]::placeholder {
      color: #6b6b6e;
    }

    .suffix {
      position: relative;
    }

    .suffix span {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 11px;
      color: #8e8e93;
      pointer-events: none;
    }

    .suffix input {
      padding-right: 24px;
    }

    .keypad-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin-top: 4px;
    }

    .btn {
      border: none;
      border-radius: 999px;
      padding: 14px 0;
      font-size: 18px;
      font-weight: 500;
      cursor: pointer;
      transition: transform 0.05s ease, filter 0.05s ease;
      color: var(--text-main);
    }

    .btn:active {
      transform: scale(0.97);
      filter: brightness(1.2);
    }

    .btn-dark {
      background: var(--bg-key-dark);
    }

    .btn-light {
      background: var(--bg-key-light);
      color: #000;
    }

    .btn-accent {
      background: var(--bg-key-accent);
    }

    .btn-wide {
      grid-column: span 2;
    }

    .summary {
      margin-top: 10px;
      padding: 10px 12px;
      border-radius: 18px;
      background: #1c1c1e;
      font-size: 13px;
      line-height: 1.5;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 2px;
    }

    .summary-row span:first-child {
      color: var(--text-muted);
    }

    .summary-row.strong span:last-child {
      font-weight: 600;
      font-size: 15px;
    }

    @media (max-width: 420px) {
      .screen-main {
        font-size: 26px;
      }
    }
  </style>
</head>
<body>
  <div class="calculator">
    <div class="screen">
      <div>
        <div class="screen-title">Calculadora de autónomos</div>
        <div id="screenMain" class="screen-main">0,00 €</div>
      </div>
      <div id="screenSub" class="screen-sub">
Introduce un importe base, los impuestos y (opcionalmente) los gastos para ver el beneficio real.
      </div>
    </div>

    <div class="section-title">Factura que emites</div>
    <div class="inputs">
      <div class="input-block full">
        <label>Importe base del trabajo (sin IVA)</label>
        <div class="suffix">
          <input type="number" id="baseTrabajo" placeholder="0,00" step="0.01" min="0" />
          <span>€</span>
        </div>
      </div>

      <div class="input-block">
        <label>IVA aplicado</label>
        <div class="suffix">
          <input type="number" id="ivaTrabajo" placeholder="21" step="0.01" min="0" />
          <span>%</span>
        </div>
      </div>

      <div class="input-block">
        <label>IRPF retenido</label>
        <div class="suffix">
          <input type="number" id="irpfTrabajo" placeholder="15" step="0.01" min="0" />
          <span>%</span>
        </div>
      </div>
    </div>

    <div class="section-title">Gastos asociados a este trabajo (opcional)</div>
    <div class="inputs">
      <div class="input-block full">
        <label>Base de gastos (sin IVA)</label>
        <div class="suffix">
          <input type="number" id="baseGastos" placeholder="0,00" step="0.01" min="0" />
          <span>€</span>
        </div>
      </div>

      <div class="input-block">
        <label>IVA de los gastos</label>
        <div class="suffix">
          <input type="number" id="ivaGastos" placeholder="21" step="0.01" min="0" />
          <span>%</span>
        </div>
      </div>
    </div>

    <div class="keypad-row">
      <button class="btn btn-light btn-wide" id="btnLimpiar">AC</button>
      <button class="btn btn-dark" id="btnCalcular">=</button>
      <button class="btn btn-accent" id="btnSoloBeneficio">Net</button>
    </div>

    <div class="summary" id="summaryBox">
      <div class="summary-row">
        <span>Base trabajo:</span>
        <span id="resBaseTrabajo">0,00 €</span>
      </div>
      <div class="summary-row">
        <span>IVA factura:</span>
        <span id="resIvaTrabajo">0,00 €</span>
      </div>
      <div class="summary-row">
        <span>IRPF factura:</span>
        <span id="resIrpfTrabajo">0,00 €</span>
      </div>
      <div class="summary-row strong">
        <span>Total factura (cliente):</span>
        <span id="resTotalFactura">0,00 €</span>
      </div>
      <div class="summary-row strong">
        <span>Neto que cobras:</span>
        <span id="resNetoCobras">0,00 €</span>
      </div>
      <hr style="border: none; border-top: 1px solid #2c2c2e; margin: 6px 0;" />
      <div class="summary-row">
        <span>Base gastos:</span>
        <span id="resBaseGastos">0,00 €</span>
      </div>
      <div class="summary-row">
        <span>IVA gastos:</span>
        <span id="resIvaGastos">0,00 €</span>
      </div>
      <div class="summary-row strong">
        <span>Total gastos:</span>
        <span id="resTotalGastos">0,00 €</span>
      </div>
      <hr style="border: none; border-top: 1px solid #2c2c2e; margin: 6px 0;" />
      <div class="summary-row strong">
        <span>Beneficio real tras gastos:</span>
        <span id="resBeneficioReal">0,00 €</span>
      </div>
    </div>
  </div>

  <script>
    function toNumber(value) {
      const n = parseFloat(value.replace(",", "."));
      return isNaN(n) ? 0 : n;
    }

    function formatEuro(value) {
      return value.toLocaleString("es-ES", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }) + " €";
    }

    function calcular(ignorarGastos = false) {
      const baseTrabajo = toNumber(document.getElementById("baseTrabajo").value || "0");
      const ivaTrabajo = toNumber(document.getElementById("ivaTrabajo").value || "0");
      const irpfTrabajo = toNumber(document.getElementById("irpfTrabajo").value || "0");
      const baseGastos = ignorarGastos ? 0 : toNumber(document.getElementById("baseGastos").value || "0");
      const ivaGastos = ignorarGastos ? 0 : toNumber(document.getElementById("ivaGastos").value || "0");

      // Factura que emites
      const ivaFactura = baseTrabajo * (ivaTrabajo / 100);
      const irpfFactura = baseTrabajo * (irpfTrabajo / 100);
      const totalFactura = baseTrabajo + ivaFactura - irpfFactura; // Lo que paga el cliente
      const netoCobras = totalFactura; // Lo que realmente te entra

      // Gastos
      const ivaSobreGastos = baseGastos * (ivaGastos / 100);
      const totalGastos = baseGastos + ivaSobreGastos;

      // Beneficios
      const beneficioAntesGastos = netoCobras;
      const beneficioReal = beneficioAntesGastos - totalGastos;

      // Actualizar resumen
      document.getElementById("resBaseTrabajo").textContent = formatEuro(baseTrabajo);
      document.getElementById("resIvaTrabajo").textContent = formatEuro(ivaFactura);
      document.getElementById("resIrpfTrabajo").textContent = formatEuro(irpfFactura);
      document.getElementById("resTotalFactura").textContent = formatEuro(baseTrabajo + ivaFactura - irpfFactura);
      document.getElementById("resNetoCobras").textContent = formatEuro(netoCobras);

      document.getElementById("resBaseGastos").textContent = formatEuro(baseGastos);
      document.getElementById("resIvaGastos").textContent = formatEuro(ivaSobreGastos);
      document.getElementById("resTotalGastos").textContent = formatEuro(totalGastos);
      document.getElementById("resBeneficioReal").textContent = formatEuro(beneficioReal);

      // Pantalla principal
      document.getElementById("screenMain").textContent = formatEuro(beneficioReal);

      const textoSub =
        "Factura:\n" +
        "Base: " + formatEuro(baseTrabajo) +
        "   IVA: " + formatEuro(ivaFactura) +
        "   IRPF: " + formatEuro(irpfFactura) +
        "\nNeto que cobras: " + formatEuro(netoCobras) +
        "\n\nGastos totales: " + formatEuro(totalGastos);

      document.getElementById("screenSub").textContent = textoSub;
    }

    function limpiar() {
      document.getElementById("baseTrabajo").value = "";
      document.getElementById("ivaTrabajo").value = "";
      document.getElementById("irpfTrabajo").value = "";
      document.getElementById("baseGastos").value = "";
      document.getElementById("ivaGastos").value = "";

      calcular(true);
      document.getElementById("screenMain").textContent = "0,00 €";
      document.getElementById("screenSub").textContent =
        "Introduce un importe base, los impuestos y (opcionalmente) los gastos para ver el beneficio real.";
    }

    document.getElementById("btnCalcular").addEventListener("click", function () {
      calcular(false);
    });

    document.getElementById("btnSoloBeneficio").addEventListener("click", function () {
      calcular(true);
    });

    document.getElementById("btnLimpiar").addEventListener("click", limpiar);

    // Recalcular en tiempo real al escribir
    ["baseTrabajo", "ivaTrabajo", "irpfTrabajo", "baseGastos", "ivaGastos"].forEach((id) => {
      document.getElementById(id).addEventListener("input", () => calcular(false));
    });

    // Estado inicial
    calcular(true);
  </script>
</body>
</html>
